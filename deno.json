{
  "tasks": {
    "test": "deno test --allow-env",
    "test-node": "tsx --test",
    "test-bun": "bun test"
  },
  "workspace": [
    "./command",
    "./core",
    "./web",
    "./vendor/hono"
  ],
  "fmt": {
    "lineWidth": 80,
    "exclude": [
      "docs/**",
      "node_modules/**"
    ]
  },
  "compilerOptions": {
    "experimentalDecorators": false,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "nodeModulesDir": "manual"
}
