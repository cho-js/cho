{
  "tasks": {
    "cli": "deno run --allow-env --allow-net --allow-read --allow-write cli/main.ts",
    "test": "deno test --allow-env --allow-net --allow-read",
    "test-node": "tsx --test",
    "test-bun": "bun test"
  },
  "workspace": [
    "./command",
    "./core",
    "./web",
    "./message",
    "./vendor/hono",
    "./vendor/cho",
    "./vendor/fastify",
    "./vendor/kafka",
    "./vendor/nats",
    "./extras/openapi",
    "./extras/dev",
    "./extras/prompt",
    "./cli"
  ],
  "imports": {
    "@nats-io/transport-deno": "jsr:@nats-io/transport-deno@^3.4.0",
    "@nats-io/jetstream-deno": "jsr:@nats-io/jetstream@^3.4.0"
  },
  "exclude": [
    "tools/workerd/",
    "cli/npm/",
    "examples/worker/"
  ],
  "fmt": {
    "lineWidth": 80,
    "exclude": [
      "docs/**",
      "node_modules/**"
    ]
  },
  "compilerOptions": {
    "experimentalDecorators": false,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "nodeModulesDir": "manual"
}
