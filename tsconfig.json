{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "esnext",
    "target": "esnext",
    "types": ["node"],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node
    "moduleResolution": "nodenext",
    // Workspace packages for Node (tsx) and Bun, which do not read the Deno
    // workspace. Keep in sync with the `exports` of each package's deno.json.
    "paths": {
      "@chojs/core": ["./core/mod.ts"],
      "@chojs/core/di": ["./core/di/mod.ts"],
      "@chojs/core/utils": ["./core/utils/mod.ts"],
      "@chojs/core/utils/test_utils": ["./core/utils/test_utils.ts"],
      "@chojs/command": ["./command/mod.ts"],
      "@chojs/web": ["./web/mod.ts"],
      "@chojs/web/linker": ["./web/linker.ts"],
      "@chojs/web/graph": ["./web/graph.ts"],
      "@chojs/vendor-hono": ["./vendor/hono/mod.ts"]
    },

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,
    "allowImportingTsExtensions": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
