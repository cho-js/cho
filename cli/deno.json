{
  "name": "@chojs/cli",
  "version": "3.7.1",
  "license": "MIT",
  "exports": "./main.ts",
  "tasks": {
    "gen": "deno run --allow-read --allow-write --allow-run new/gen.ts",
    "npm": "deno run --allow-read --allow-write --allow-run npm.ts"
  },
  "publish": {
    "exclude": [
      "./**/*_test.ts",
      "./npm.ts",
      "./npm/",
      "./new/gen.ts",
      "./new/templates/",
      "./new/testing.ts"
    ]
  }
}
